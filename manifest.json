{
  "manifest_version": 3,
  "name": "InfoSys Management",
  "version": "1.0.0",
  "description": "Hệ thống Quản lý InfoSys Extension",
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "action": {
    "default_title": "Mở InfoSys"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
